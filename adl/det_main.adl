"related display" {
	object {
		x="15"
		y="298"
		width="300"
		height="22"
		groupid="0"
	}
	selfkill="off"
	display[0] {
		label="SET FRAME SIZE"
		name="det_frameSize.dl"
		args="top=$(top),sensor=$(sensor),cad=detFrameSize,car=det"
	}
	display[1] {
		label="SET OBSERVATION TYPE"
		name="det_obstype.dl"
		args="top=$(top),sensor=$(sensor),cad=detObstype,car=det"
	}
	display[2] {
		label="SET WCS CALIBRATION"
		name="det_setwcs.dl"
		args="top=$(top),sensor=$(sensor),cad=detSetWcs,car=det"
	}
	display[3] {
		label=""
		name=""
		args=""
	}
