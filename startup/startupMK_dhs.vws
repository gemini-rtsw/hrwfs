# $Id: startupMK_dhs.vws,v 1.3 2001-12-21 02:42:12 cboyer Exp $
#
# VxWorks startup script to init dhs after startupMK_nodhs.vws has been loaded
#
# GEMINI NORTH - HRWFS startup dhs script.
#

# start the impmaster
taskSpawn ( "ImpMaster", 100, 0x8, 20000, ImpMaster)

taskDelay (10*sysClkRateGet())

# Initialise the DHS for the detector controllers 
# (clientName, numConnect, hostName, serverName)
detDhsParamInit ("hrwfs", 16, "10.2.4.56", "dataServerNS")

# Init the DHS
detDhsInit() 

# Init the detDhsConnected variable to NOT_CONNECTED
detDhsConnected=2
