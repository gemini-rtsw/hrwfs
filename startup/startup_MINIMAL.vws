# $Id: startup_MINIMAL.vws,v 1.4 2000-01-05 20:10:31 cboyer Exp $
#
# VxWorks startup script to load and execute system (iocCore) software.
#
# MINIMAL STARTUP SCRIPT. This script does as little as possible, to allow
# scripts to be run manually on the Baja for testing purposes.
#

shellPromptSet "Minimal startup hrwfs> "

# Make delete key work for backspace
tyBackspaceSet 0177

# Execute Gemini VxWorks script to ensure all users are recognised.
< /gemini/external/vxWorks/vxUsers

routeAdd "0.0.0.0" , "10.2.2.1"
routeAdd "0.0.0.0" , "10.1.2.1"

# cd to application install startup directory (beware automounter problems)
cd "$(iocpath)/bin/$(arch)"
#cd "$(install)/bin/$(arch)"
pwd

# Now execute a script manually using "< script"
