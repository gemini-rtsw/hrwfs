# $Id: startup_MINIMAL.vws,v 1.7 2001-10-26 03:28:11 cboyer Exp $
#
# Minimal VxWorks startup script for HRWFS
#

# Execute Gemini VxWorks script to ensure all users are recognised.
< /gemini/external/vxWorks/tornado2.0/vxUsers

# Set the prompt
shellPromptSet "Minimal startup hrwfs> "

# Make delete key work for backspace
tyBackspaceSet 0177

# cd to application install startup directory (beware automounter problems)
cd "$(iocpath)/bin/$(arch)"
#cd "$(install)/bin/$(arch)"
pwd
