# pvload defaults to commands for HRWFS Detector Controller

#
# Set up defaults for detFrameSize CAD commands
#

group {
int $(top)$(wfs)initFrameSize.A = 0 ;
int $(top)$(wfs)initFrameSize.B = 0 ;
int $(top)$(wfs)initFrameSize.C = 512 ;
int $(top)$(wfs)initFrameSize.D = 512 ;
int $(top)$(wfs)initFrameSize.E = 100 ;
int $(top)$(wfs)initFrameSize.F = 100 ;
int $(top)$(wfs)initFrameSize.G = 0 ;
};
