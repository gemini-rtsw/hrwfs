# Init file for HRWFS detector controller 
# Default target temperature (between -40.0C and 0C)
-20.0
# Default temperature coefficient - do not change
128
# Default ADC offset for output 0 - no binning
2345
# Default ADC offset for output 1 - no binning
2350
# Default ADC offset for output 0 - binning 
2345
# Default ADC offset for output 1 - binning
2350
# Default serial number of the CCD - do not change
8283-4-3
# Default instrument name - do not change
hrwfs
# Default port where A&G is located - do not change
-1
